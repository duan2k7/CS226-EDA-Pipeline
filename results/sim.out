#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
S_0x6308b6df5d70 .scope module, "counter_8bit_tb" "counter_8bit_tb" 2 11;
 .timescale -9 -12;
v0x6308b6e17140_0 .var "clk", 0 0;
v0x6308b6e17200_0 .net "count", 7 0, v0x6308b6e16d20_0;  1 drivers
v0x6308b6e172d0_0 .var "enable", 0 0;
v0x6308b6e173d0_0 .var/i "error_count", 31 0;
v0x6308b6e17470_0 .var "rst_n", 0 0;
v0x6308b6e17560_0 .var "up_down", 0 0;
S_0x6308b6df5f00 .scope module, "uut" "counter_8bit" 2 26, 3 9 0, S_0x6308b6df5d70;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "rst_n";
    .port_info 2 /INPUT 1 "enable";
    .port_info 3 /INPUT 1 "up_down";
    .port_info 4 /OUTPUT 8 "count";
v0x6308b6df60e0_0 .net "clk", 0 0, v0x6308b6e17140_0;  1 drivers
v0x6308b6e16d20_0 .var "count", 7 0;
v0x6308b6e16e00_0 .net "enable", 0 0, v0x6308b6e172d0_0;  1 drivers
v0x6308b6e16ed0_0 .net "rst_n", 0 0, v0x6308b6e17470_0;  1 drivers
v0x6308b6e16f90_0 .net "up_down", 0 0, v0x6308b6e17560_0;  1 drivers
E_0x6308b6df6610/0 .event negedge, v0x6308b6e16ed0_0;
E_0x6308b6df6610/1 .event posedge, v0x6308b6df60e0_0;
E_0x6308b6df6610 .event/or E_0x6308b6df6610/0, E_0x6308b6df6610/1;
    .scope S_0x6308b6df5f00;
T_0 ;
    %wait E_0x6308b6df6610;
    %load/vec4 v0x6308b6e16ed0_0;
    %nor/r;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 8;
    %assign/vec4 v0x6308b6e16d20_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v0x6308b6e16e00_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.2, 8;
    %load/vec4 v0x6308b6e16f90_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.4, 8;
    %load/vec4 v0x6308b6e16d20_0;
    %addi 1, 0, 8;
    %assign/vec4 v0x6308b6e16d20_0, 0;
    %jmp T_0.5;
T_0.4 ;
    %load/vec4 v0x6308b6e16d20_0;
    %subi 1, 0, 8;
    %assign/vec4 v0x6308b6e16d20_0, 0;
T_0.5 ;
T_0.2 ;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_0x6308b6df5d70;
T_1 ;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x6308b6e173d0_0, 0, 32;
    %end;
    .thread T_1;
    .scope S_0x6308b6df5d70;
T_2 ;
    %delay 10000, 0;
    %load/vec4 v0x6308b6e17140_0;
    %inv;
    %store/vec4 v0x6308b6e17140_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_0x6308b6df5d70;
T_3 ;
    %vpi_call 2 39 "$dumpfile", "results/waves.vcd" {0 0 0};
    %vpi_call 2 40 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x6308b6df5d70 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308b6e17140_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308b6e17470_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308b6e172d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6308b6e17560_0, 0, 1;
    %vpi_call 2 48 "$display", "--------------------------------------------------" {0 0 0};
    %vpi_call 2 49 "$display", "[TB] BAT DAU KIEM THU MODULE COUNTER_8BIT" {0 0 0};
    %vpi_call 2 50 "$display", "--------------------------------------------------" {0 0 0};
    %delay 25000, 0;
    %load/vec4 v0x6308b6e17200_0;
    %cmpi/ne 0, 0, 8;
    %jmp/0xz  T_3.0, 6;
    %vpi_call 2 55 "$display", "[FAIL] Loi Reset: count = %h (mong doi 00)", v0x6308b6e17200_0 {0 0 0};
    %load/vec4 v0x6308b6e173d0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x6308b6e173d0_0, 0, 32;
    %jmp T_3.1;
T_3.0 ;
    %vpi_call 2 58 "$display", "[PASS] Reset thanh cong, count = 00" {0 0 0};
T_3.1 ;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6308b6e17470_0, 0, 1;
    %delay 15000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6308b6e172d0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x6308b6e17560_0, 0, 1;
    %delay 100000, 0;
    %load/vec4 v0x6308b6e17200_0;
    %cmpi/ne 5, 0, 8;
    %jmp/0xz  T_3.2, 6;
    %vpi_call 2 70 "$display", "[FAIL] Loi Count Up: count = %d (mong doi 5)", v0x6308b6e17200_0 {0 0 0};
    %load/vec4 v0x6308b6e173d0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x6308b6e173d0_0, 0, 32;
    %jmp T_3.3;
T_3.2 ;
    %vpi_call 2 73 "$display", "[PASS] Count Up thanh cong, count = %d", v0x6308b6e17200_0 {0 0 0};
T_3.3 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308b6e17560_0, 0, 1;
    %delay 60000, 0;
    %load/vec4 v0x6308b6e17200_0;
    %cmpi/ne 2, 0, 8;
    %jmp/0xz  T_3.4, 6;
    %vpi_call 2 80 "$display", "[FAIL] Loi Count Down: count = %d (mong doi 2)", v0x6308b6e17200_0 {0 0 0};
    %load/vec4 v0x6308b6e173d0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x6308b6e173d0_0, 0, 32;
    %jmp T_3.5;
T_3.4 ;
    %vpi_call 2 83 "$display", "[PASS] Count Down thanh cong, count = %d", v0x6308b6e17200_0 {0 0 0};
T_3.5 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x6308b6e172d0_0, 0, 1;
    %delay 40000, 0;
    %load/vec4 v0x6308b6e17200_0;
    %cmpi/ne 2, 0, 8;
    %jmp/0xz  T_3.6, 6;
    %vpi_call 2 90 "$display", "[FAIL] Loi Disable: count bi thay doi = %d", v0x6308b6e17200_0 {0 0 0};
    %load/vec4 v0x6308b6e173d0_0;
    %addi 1, 0, 32;
    %store/vec4 v0x6308b6e173d0_0, 0, 32;
    %jmp T_3.7;
T_3.6 ;
    %vpi_call 2 93 "$display", "[PASS] Disable thanh cong, count giu nguyen = %d", v0x6308b6e17200_0 {0 0 0};
T_3.7 ;
    %vpi_call 2 97 "$display", "--------------------------------------------------" {0 0 0};
    %load/vec4 v0x6308b6e173d0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_3.8, 4;
    %vpi_call 2 99 "$display", "[SIMULATION] ALL TESTS COMPLETED SUCCESSFULLY" {0 0 0};
    %vpi_call 2 100 "$display", "[RESULT] TEST PASS - MODULE HOAT DONG DUNG THIET KE" {0 0 0};
    %jmp T_3.9;
T_3.8 ;
    %vpi_call 2 102 "$display", "[SIMULATION] FAILED WITH %d ERRORS", v0x6308b6e173d0_0 {0 0 0};
    %vpi_call 2 103 "$display", "[RESULT] TEST FAIL - CO LOI TRONG LOGIC THIET KE" {0 0 0};
T_3.9 ;
    %vpi_call 2 105 "$display", "--------------------------------------------------" {0 0 0};
    %vpi_call 2 107 "$finish" {0 0 0};
    %end;
    .thread T_3;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "tb/counter_8bit_tb.v";
    "src/counter_8bit.v";
